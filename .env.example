# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GitHub fine-grained personal access token, limited to the report repository,
# with "Contents: Read and write" permission
GITHUB_TOKEN=

# Repository the agent publishes its report to (not secret)
GITHUB_USER=
GITHUB_REPO=
